# ------------------------------------------------------------
# Core app URLs and ports
# ------------------------------------------------------------
# Backend API port (Hono server)
PORT=8787

# Frontend base URL for API requests (Vite)
# Keep this in sync with PORT above for local development.
VITE_API_URL=http://localhost:8787

# Comma-separated list of allowed frontend origins for backend CORS
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------
# SQLite development mode
# ------------------------------------------------------------
# true  -> use SQLite as primary DB (no Postgres dependency)
# false -> use Postgres via DATABASE_URL
DEBUG_SQLITE_ONLY=false

# Optional debug mirror while using Postgres mode
DEBUG_SQLITE_MIRROR=false

# SQLite file path used for SQLite primary mode and mirror mode
DEBUG_SQLITE_PATH=server/db/sqlite/debug-mirror.sqlite

# ------------------------------------------------------------
# Postgres / Docker Compose (used when DEBUG_SQLITE_ONLY=false)
# ------------------------------------------------------------
POSTGRES_CONTAINER_NAME=hackathon-postgres
POSTGRES_DB=hackathonDB
POSTGRES_USER=hackathon
POSTGRES_PASSWORD=hackathon
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Backend Postgres connection string
# Update this if you change Postgres user/password/db above.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Admin moderation endpoint secret (change before sharing/production)
ADMIN_SECRET=replace-with-strong-secret
